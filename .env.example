# Copie para .env e preencha. NUNCA envie o .env para o GitHub.
# Na Vercel, cadastre estas mesmas variáveis em Project → Settings → Environment Variables.

# Banco PostgreSQL (Neon ou Supabase têm plano gratuito). Use a URL com pooling em DATABASE_URL
# e a conexão direta em DIRECT_DATABASE_URL (para as migrações).
DATABASE_URL="postgresql://usuario:senha@host:5432/otica?sslmode=require"
DIRECT_DATABASE_URL="postgresql://usuario:senha@host:5432/otica?sslmode=require"

# Endereço público do site (sem barra no final)
APP_URL="http://localhost:3000"

# Gere com: openssl rand -base64 32   (guarde uma cópia em local seguro: sem ela as receitas não podem ser lidas)
ENCRYPTION_KEY=""
# Gere com: openssl rand -base64 48
SESSION_SECRET=""

# Pagamentos: "mock" (simulado, só desenvolvimento) ou "mercadopago"
PAYMENT_PROVIDER="mock"
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
PIX_EXPIRATION_MINUTES="30"
MAX_INSTALLMENTS="6"

# Arquivos: "local" (desenvolvimento) ou "vercel-blob" (produção)
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# E-mails (Resend). Sem chave, os e-mails aparecem só no terminal.
RESEND_API_KEY=""
EMAIL_FROM="Espaço Óptico Luísa <nao-responda@espacoopticoluisa.com.br>"
STORE_NOTIFY_EMAIL=""

# Proteção contra robôs no Fale conosco (Cloudflare Turnstile, opcional)
TURNSTILE_SECRET_KEY=""

# Rotina diária (Vercel Cron)
CRON_SECRET=""

# Usuário proprietário criado pelo "npm run db:seed"
SEED_OWNER_EMAIL=""
SEED_OWNER_NAME=""
SEED_OWNER_PASSWORD=""
